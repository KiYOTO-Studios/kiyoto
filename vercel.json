{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "DE|AT" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/de",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "JP" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/jp",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "KR" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/kr",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "ES|MX|AR|CO|CL|PE|VE|EC|GT|CU|BO|DO|HN|PY|SV|NI|CR|PA|UY" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "FR|MC" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/fr",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "BR|PT" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/pt",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "CN" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "IT|SM" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/it",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "NL" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/nl",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "RU" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/ru",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "SA|AE|EG|IQ|MA|DZ|SD|SY|YE|TN|JO|LY|LB|OM|KW|QA|BH" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/ar",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "TR" }],
      "missing": [{ "type": "cookie", "key": "KIYOTO_LOCALE" }],
      "destination": "/tr",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)", "destination": "/index.html" },
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)/about", "destination": "/index.html" },
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)/privacy", "destination": "/privacy.html" },
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)/terms", "destination": "/terms.html" },
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)/cookies", "destination": "/cookies.html" },
    { "source": "/:locale(en|de|ja|jp|ko|kr|es|fr|pt|zh|it|nl|ru|ar|hi|tr)/refunds", "destination": "/refunds.html" },
    { "source": "/about", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.(html|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
